# ===========================================
# ChaseAI Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_NG_MONTHLY_PLAN_CODE=your_plan_code
PAYSTACK_US_MONTHLY_PLAN_CODE=your_plan_code
PAYSTACK_INTL_MONTHLY_PLAN_CODE=your_plan_code
PAYSTACK_EARLY_BIRD_PLAN_CODE=your_plan_code

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key
STRIPE_PRICE_ID_MONTHLY=your_price_id
STRIPE_PRICE_ID_LIFETIME=your_price_id

# AI Configuration
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key
AI_PROVIDER=gemini  # Options: groq, openai, gemini, xai

# Hybrid AI Service (Railway)
AI_API_URL=https://web-production-2893d.up.railway.app
AI_API_KEY=your_chaseai_service_token
AI_DYNAMO_SALT=your_random_salt_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=invoices@yourdomain.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_random_cron_secret
